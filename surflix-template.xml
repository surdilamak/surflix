<?xml version="1.0"?>
<Container version="2">
  <Name>Surflix</Name>
  <Repository>ghcr.io/idrus/surflix:latest</Repository>
  <Registry>https://ghcr.io/idrus/surflix</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/surdilamak/surflix/issues</Support>
  <Project>https://github.com/surdilamak/surflix</Project>
  <Overview>
    Custom request hub untuk Jellyfin/Jellyseerr.&#xD;
    Apple-style UI, admin approval workflow, magic link auth untuk guest.&#xD;
    &#xD;
    Cocok untuk share library Jellyfin lo ke keluarga/teman dengan UX yang lebih simple dari Jellyseerr default.
  </Overview>
  <Category>MediaApp:Video MediaServer:Other</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/surdilamak/surflix/main/surflix-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/surdilamak/surflix/main/public/icon-512.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <!-- ===== PORTS ===== -->
  <Config Name="WebUI Port" Target="3000" Default="3737" Mode="tcp" Description="Port untuk akses Surflix (default: 3737)" Type="Port" Display="always" Required="true" Mask="false">3737</Config>

  <!-- ===== VOLUMES ===== -->
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/surflix" Mode="rw" Description="Folder untuk database SQLite" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/surflix</Config>

  <!-- ===== APP CONFIG ===== -->
  <Config Name="App URL" Target="NEXT_PUBLIC_APP_URL" Default="https://request.surdilamak.my.id" Mode="" Description="URL publik Surflix (untuk magic link email)" Type="Variable" Display="always" Required="true" Mask="false">https://request.surdilamak.my.id</Config>

  <Config Name="Jellyfin URL" Target="NEXT_PUBLIC_JELLYFIN_URL" Default="https://jellyfin.surdilamak.my.id" Mode="" Description="URL Jellyfin untuk tombol 'Watch on Jellyfin'" Type="Variable" Display="always" Required="true" Mask="false">https://jellyfin.surdilamak.my.id</Config>

  <!-- ===== JELLYSEERR ===== -->
  <Config Name="Jellyseerr URL" Target="JELLYSEERR_URL" Default="http://jellyseerr:5055" Mode="" Description="URL internal Jellyseerr (pakai container name kalau di network yang sama)" Type="Variable" Display="always" Required="true" Mask="false">http://jellyseerr:5055</Config>

  <Config Name="Jellyseerr API Key" Target="JELLYSEERR_API_KEY" Default="" Mode="" Description="API Key dari Jellyseerr (Settings → General → API Key)" Type="Variable" Display="always" Required="true" Mask="true"/>

  <!-- ===== ADMIN AUTH ===== -->
  <Config Name="Session Secret" Target="SESSION_SECRET" Default="" Mode="" Description="Random string 32+ karakter. Generate: openssl rand -base64 32" Type="Variable" Display="always" Required="true" Mask="true"/>

  <Config Name="Admin Username" Target="ADMIN_USERNAME" Default="idrus" Mode="" Description="Username admin untuk login ke admin panel" Type="Variable" Display="always" Required="true" Mask="false">idrus</Config>

  <Config Name="Admin Password Hash" Target="ADMIN_PASSWORD_HASH" Default="" Mode="" Description="Bcrypt hash dari password admin. Generate via scripts/gen-password.js" Type="Variable" Display="always" Required="true" Mask="true"/>

  <!-- ===== EMAIL ===== -->
  <Config Name="Resend API Key" Target="RESEND_API_KEY" Default="" Mode="" Description="API Key dari resend.com untuk kirim email (magic link, notif)" Type="Variable" Display="always" Required="false" Mask="true"/>

  <Config Name="Email From" Target="EMAIL_FROM" Default="Surflix &lt;noreply@surdilamak.my.id&gt;" Mode="" Description="Sender email" Type="Variable" Display="always" Required="false" Mask="false">Surflix &lt;noreply@surdilamak.my.id&gt;</Config>

  <!-- ===== TELEGRAM ===== -->
  <Config Name="Telegram Bot Token" Target="TELEGRAM_BOT_TOKEN" Default="" Mode="" Description="Bot token dari @BotFather (untuk notif admin)" Type="Variable" Display="always" Required="false" Mask="true"/>

  <Config Name="Telegram Chat ID" Target="TELEGRAM_ADMIN_CHAT_ID" Default="" Mode="" Description="Chat ID admin (dapet via @userinfobot)" Type="Variable" Display="always" Required="false" Mask="false"/>

  <!-- ===== WEBHOOK ===== -->
  <Config Name="Webhook Secret" Target="WEBHOOK_SECRET" Default="" Mode="" Description="Secret untuk verify webhook dari Jellyseerr. Generate: openssl rand -hex 32" Type="Variable" Display="always" Required="true" Mask="true"/>

  <!-- ===== OPTIONAL ===== -->
  <Config Name="Rate Limit Max" Target="RATE_LIMIT_MAX" Default="10" Mode="" Description="Max requests per IP per jam" Type="Variable" Display="advanced" Required="false" Mask="false">10</Config>

  <Config Name="Rate Limit Window (ms)" Target="RATE_LIMIT_WINDOW_MS" Default="3600000" Mode="" Description="Rate limit window dalam ms (default: 1 jam)" Type="Variable" Display="advanced" Required="false" Mask="false">3600000</Config>

  <Config Name="Database URL" Target="DATABASE_URL" Default="file:/data/surflix.db" Mode="" Description="SQLite path (jangan diubah)" Type="Variable" Display="advanced" Required="false" Mask="false">file:/data/surflix.db</Config>

</Container>
