# ==============================================================
# Surflix Environment Variables
# Copy ke .env dan isi dengan value sebenarnya
# ==============================================================

# --- App Config ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://request.surdilamak.my.id
NEXT_PUBLIC_APP_NAME=Surflix
NEXT_PUBLIC_JELLYFIN_URL=https://jellyfin.surdilamak.my.id

# --- Database ---
DATABASE_URL="file:/data/surflix.db"

# --- Jellyseerr Integration ---
# Internal Docker hostname, gak perlu HTTPS karena internal network
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=ganti_dengan_api_key_dari_jellyseerr

# --- Admin Auth ---
# Generate dengan: openssl rand -base64 32
SESSION_SECRET=ganti_dengan_string_random_minimal_32_karakter
ADMIN_USERNAME=idrus
# Hash dengan bcrypt, atau pakai script gen-password.js
ADMIN_PASSWORD_HASH=ganti_dengan_bcrypt_hash

# --- Email (Resend) ---
# Daftar di resend.com, dapat free 100 emails/day
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Surflix <noreply@surdilamak.my.id>"

# --- Telegram Bot (Admin Notification) ---
# Buat bot via @BotFather, dapat token-nya
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Chat ID lo sendiri, dapat via @userinfobot
TELEGRAM_ADMIN_CHAT_ID=123456789

# --- Rate Limiting ---
# Max request per IP per hour
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000

# --- Webhook Security ---
# Token random buat verify webhook dari Jellyseerr
WEBHOOK_SECRET=ganti_dengan_string_random
