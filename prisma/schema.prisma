// Surflix Database Schema
// Stack: SQLite + Prisma
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// GUEST: the people who request films
// Identified via email + name (no password)
// Magic link to access the "My Requests" page
// =====================================================
model Guest {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())
  // Last language chosen by the guest (cookie surflix_lang): 'en' | 'id'. Null = old guest, treat as 'id'.
  lang       String?

  // Alias chain: if this Guest is a duplicate (pre-bugfix), `mergedIntoId`
  // points to the canonical Guest. APIs follow the alias to the root before reading/writing requests.
  mergedIntoId String?
  mergedInto   Guest?  @relation("GuestMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  aliases      Guest[] @relation("GuestMerge")

  requests     Request[]
  remarks      Remark[]
  magicTokens  MagicToken[]
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([mergedIntoId])
}

// =====================================================
// MAGIC TOKEN: for passwordless guest login
// Token is sent via email, expires in 30 minutes
// =====================================================
model MagicToken {
  id        String   @id @default(cuid())
  token     String   @unique
  guestId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// =====================================================
// REQUEST: film/series request from a guest
// =====================================================
model Request {
  id        String        @id @default(cuid())
  guestId   String

  // TMDB metadata (cached so it does not need to be re-fetched)
  tmdbId       Int
  mediaType    String   // "movie" | "tv"
  title        String
  posterPath   String?
  backdropPath String?
  overview     String?
  releaseDate  String?
  rating       Float?

  // Status workflow (String, possible values: PENDING_ADMIN, REJECTED, APPROVED, ON_SCHEDULE, PROCESSING, PARTIALLY_AVAILABLE, AVAILABLE, FAILED)
  status       String   @default("PENDING_ADMIN")
  adminNote    String?
  guestNote    String?  // note from the guest (optional: request subtitles, replace a bad file, etc.)

  // Link to Jellyseerr after approval
  jellyseerrRequestId Int?
  jellyseerrMediaId   Int?

  // Timestamps for the timeline
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?
  availableAt DateTime?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([status])
  @@index([tmdbId, mediaType])
  @@index([requestedAt])
}

// =====================================================
// REQUEST STATUS VALUES (just for documentation):
// PENDING_ADMIN    : just submitted by the guest, waiting for admin approval
// REJECTED         : rejected by admin
// APPROVED         : approved, being forwarded to Jellyseerr
// ON_SCHEDULE      : already in Jellyseerr, waiting for Radarr/Sonarr to schedule the download
// PROCESSING       : Radarr/Sonarr is actively downloading
// PARTIALLY_AVAILABLE : some episodes are already available (for series)
// AVAILABLE        : ready in Jellyfin
// FAILED           : failed to process
// =====================================================

// =====================================================
// REMARK: note/improvement request from a guest for a film that
// is already in the library (AVAILABLE) or currently being downloaded (PROCESSING).
// Example: "tolong tambah subtitle Indo", "file jelek, replace please".
// Unlike Request: Remark needs no approve/reject flow, it is only
// informational for the admin to act on manually (replace file, add srt, etc.).
// =====================================================
model Remark {
  id        String   @id @default(cuid())
  guestId   String

  // TMDB metadata (snapshot taken when the remark was created)
  tmdbId       Int
  mediaType    String   // "movie" | "tv"
  title        String
  posterPath   String?

  // Snapshot of the media state when the remark was created — so the admin knows the context
  // "AVAILABLE" or "PROCESSING" (or "PARTIALLY_AVAILABLE")
  mediaStatus  String

  // Note from the guest (REQUIRED for a remark, unlike Request.guestNote which is optional)
  note         String

  // Status workflow: PENDING (just came in) → REVIEWED (admin has seen it) → RESOLVED (admin has acted) or DISMISSED
  status       String   @default("PENDING")
  adminNote    String?

  // Timestamps
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  resolvedAt  DateTime?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([status])
  @@index([tmdbId, mediaType])
  @@index([createdAt])
}

// =====================================================
// ADMIN: only you (or a co-admin if needed later)
// =====================================================
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

// =====================================================
// RATE LIMIT: track IP per hour
// =====================================================
model RateLimit {
  id        String   @id @default(cuid())
  ipAddress String
  endpoint  String   // e.g. "request" or "magic-link"
  count     Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([ipAddress, endpoint, windowStart])
  @@index([ipAddress, endpoint])
}

// =====================================================
// PUSH SUBSCRIPTION: Web Push API subscription per device/browser
// A single Guest can have many subscriptions (multi-device).
// Triggered from the Jellyseerr webhook + admin approve/reject.
// =====================================================
model PushSubscription {
  id        String   @id @default(cuid())
  guestId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

// =====================================================
// FILM CONNECTION: reference map between films (homage / inspired / visual)
// Drafts are created by the LLM when the admin triggers it, shown to guests only if APPROVED.
// Guests NEVER trigger the LLM — they only read this cache.
// Only films that exist in the Jellyfin library are stored as targets.
// =====================================================
model FilmConnection {
  id              String   @id @default(cuid())

  // Source film (the one the guest is currently viewing) — must exist in the library
  sourceTmdbId    Int
  sourceMediaType String   // "movie" | "tv"
  sourceTitle     String
  sourceYear       Int?    // for the Referensi portal (poster/year of the source film)
  sourceJellyfinId String? // Jellyfin itemId of the source film

  // Target film (the one being referenced)
  targetTmdbId     Int
  targetMediaType  String  // "movie" | "tv"
  targetTitle      String
  targetYear       Int?
  targetPoster     String? // TMDB poster path
  targetJellyfinId String? // Jellyfin itemId for the watch deep-link

  // Direction: the source REFERENCES the target (source = the newer film / the one borrowing).
  // "homage" | "inspired" | "visual" | "remake" | "universe" | "director" | "talent"
  relationship    String
  reason          String   // short reason (Indonesian), <= ~160 chars
  reasonEn        String?  // short reason (English) — the portal's main language
  // One-paragraph explanation (what connects the two titles and what is worth noticing).
  // Optional and additive: rows without one keep showing the short reason above, so the
  // paragraphs can be rolled out gradually. Source: scripts/curated/stories.txt.
  storyEn         String?  // paragraph, English (main portal language)
  story           String?  // paragraph, Indonesian
  // Optional finer label for the relationship, e.g. "prequel", "spinoff", "recut" (see REL_KINDS in
  // lib/i18n.ts). Without one the generic label of the relationship type is shown.
  kind            String?
  confidence     String   @default("medium") // "high" (documented) | "medium" (often discussed)

  // Status: PENDING_REVIEW -> APPROVED | REJECTED
  status          String   @default("PENDING_REVIEW")
  source          String   @default("llm") // "llm" | "admin"

  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@unique([sourceTmdbId, sourceMediaType, targetTmdbId])
  @@index([sourceTmdbId, sourceMediaType, status])
  @@index([status])
}

// =====================================================
// LIBRARY TITLE: snapshot of the Jellyfin library contents (films & series) for the Referensi portal.
// Used for search & the backoffice (which ones already have references, which do not yet).
// Synced from Jellyfin (admin) or imported from scripts/library-seed.json.
// =====================================================
model LibraryTitle {
  id            String   @id @default(cuid())
  tmdbId        Int
  mediaType     String   // "movie" | "tv"
  title         String   // clean title (Jellyfin file names are often messy)
  originalTitle String?
  year          Int?
  jellyfinId    String
  genres        String?  // comma-separated
  directors     String?  // comma-separated
  addedAt       DateTime? // when the title entered Jellyfin (DateCreated); null until the next sync
  updatedAt     DateTime @updatedAt

  @@unique([tmdbId, mediaType])
  @@index([title])
  @@index([addedAt])
}

// =====================================================
// EVENT LOG: audit trail for debugging
// =====================================================
model EventLog {
  id        String   @id @default(cuid())
  type      String   // "request.created", "request.approved", etc.
  payload   String   // JSON stringified
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}
