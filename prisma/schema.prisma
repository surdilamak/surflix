// Surflix Database Schema
// Stack: SQLite + Prisma
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// GUEST: orang-orang yang request film
// Diidentifikasi via email + nama (no password)
// Magic link untuk akses halaman "My Requests"
// =====================================================
model Guest {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())

  requests     Request[]
  remarks      Remark[]
  magicTokens  MagicToken[]

  @@index([email])
}

// =====================================================
// MAGIC TOKEN: untuk passwordless login guest
// Token dikirim via email, expired 30 menit
// =====================================================
model MagicToken {
  id        String   @id @default(cuid())
  token     String   @unique
  guestId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// =====================================================
// REQUEST: permintaan film/series dari guest
// =====================================================
model Request {
  id        String        @id @default(cuid())
  guestId   String

  // TMDB metadata (cached supaya gak perlu re-fetch)
  tmdbId       Int
  mediaType    String   // "movie" | "tv"
  title        String
  posterPath   String?
  backdropPath String?
  overview     String?
  releaseDate  String?
  rating       Float?

  // Status workflow (String, value bisa: PENDING_ADMIN, REJECTED, APPROVED, ON_SCHEDULE, PROCESSING, PARTIALLY_AVAILABLE, AVAILABLE, FAILED)
  status       String   @default("PENDING_ADMIN")
  adminNote    String?
  guestNote    String?  // catatan dari guest (opsional: minta subtitle, replace file jelek, dll)

  // Link ke Jellyseerr setelah di-approve
  jellyseerrRequestId Int?
  jellyseerrMediaId   Int?

  // Timestamps untuk timeline
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?
  availableAt DateTime?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([status])
  @@index([tmdbId, mediaType])
  @@index([requestedAt])
}

// =====================================================
// REQUEST STATUS VALUES (just for documentation):
// PENDING_ADMIN    : baru di-submit guest, nunggu approval admin
// REJECTED         : di-reject admin
// APPROVED         : di-approve, lagi di-forward ke Jellyseerr
// ON_SCHEDULE      : udah di Jellyseerr, nunggu Radarr/Sonarr schedule download
// PROCESSING       : Radarr/Sonarr lagi active download
// PARTIALLY_AVAILABLE : sebagian episode udah ada (untuk series)
// AVAILABLE        : udah ready di Jellyfin
// FAILED           : gagal di-process
// =====================================================

// =====================================================
// REMARK: catatan/improvement request dari guest untuk film yang
// sudah ada di library (AVAILABLE) atau lagi di-download (PROCESSING).
// Contoh: "tolong tambah subtitle Indo", "file jelek, replace please".
// Beda dari Request: Remark gak perlu approve/reject flow, cuma
// informational ke admin untuk action manual (replace file, add srt, dll).
// =====================================================
model Remark {
  id        String   @id @default(cuid())
  guestId   String

  // TMDB metadata (snapshot saat remark dibuat)
  tmdbId       Int
  mediaType    String   // "movie" | "tv"
  title        String
  posterPath   String?

  // Snapshot state media pas remark dibuat — biar admin tau context
  // "AVAILABLE" atau "PROCESSING" (atau "PARTIALLY_AVAILABLE")
  mediaStatus  String

  // Catatan dari guest (WAJIB untuk remark, beda dari Request.guestNote yang optional)
  note         String

  // Status workflow: PENDING (baru masuk) → REVIEWED (admin udah liat) → RESOLVED (admin udah action) atau DISMISSED
  status       String   @default("PENDING")
  adminNote    String?

  // Timestamps
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  resolvedAt  DateTime?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([status])
  @@index([tmdbId, mediaType])
  @@index([createdAt])
}

// =====================================================
// ADMIN: cuma lo (atau co-admin kalau perlu nanti)
// =====================================================
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

// =====================================================
// RATE LIMIT: track IP per hour
// =====================================================
model RateLimit {
  id        String   @id @default(cuid())
  ipAddress String
  endpoint  String   // misal "request" atau "magic-link"
  count     Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([ipAddress, endpoint, windowStart])
  @@index([ipAddress, endpoint])
}

// =====================================================
// EVENT LOG: audit trail buat debugging
// =====================================================
model EventLog {
  id        String   @id @default(cuid())
  type      String   // "request.created", "request.approved", dll
  payload   String   // JSON stringified
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}
